{
  "name": "ofrenda-de-los-modelos",
  "version": "0.1.0",
  "private": true,
  "description": "An altar where open-weight AI models come home for Día de los Muertos; Gemma 4 tends it on your device",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:e2e": "vite build --mode test --outDir dist-e2e --emptyOutDir",
    "test:e2e": "npm run build:e2e && playwright test",
    "licences": "node tools/check-licences.mjs",
    "record-voices": "tsc -p scripts/tsconfig.json && node node_modules/.cache/record-voices/scripts/record-voices.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^9.0.0",
    "jsdom": "30.1.2",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1"
  }
}
