{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "outDir": "../node_modules/.cache/record-voices"
  },
  "include": [
    "./*.ts",
    "../src/data/recorded-voices.ts",
    "../src/data/validate.ts",
    "../src/medium/template.ts",
    "../src/medium/parse.ts",
    "../src/medium/check.ts"
  ]
}
